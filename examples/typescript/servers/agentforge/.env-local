# ============================================================================
# AgentForge Intelligence Suite - Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values:
#   cp .env-local .env
# ============================================================================

# REQUIRED: EVM wallet address that receives x402 payments (USDC).
EVM_ADDRESS=

# REQUIRED: x402 facilitator that verifies and settles payments.
FACILITATOR_URL=https://x402.org/facilitator

# Blockchain network in CAIP-2 format. Base Sepolia testnet by default.
# Use eip155:8453 for Base mainnet in production.
NETWORK=eip155:84532

# Ports for the two transports. Both run from a single process.
MCP_PORT=4022
HTTP_PORT=4021

# Public base URLs advertised in the service catalog / discovery metadata.
# Set these to your deployed origins so AI agents and Agentic.market can reach you.
MCP_PUBLIC_URL=http://localhost:4022
HTTP_PUBLIC_URL=http://localhost:4021

# Optional: logging verbosity (debug | info | warn | error).
LOG_LEVEL=info

# Optional: per-payer rate limiting. Max paid calls per window per wallet.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Optional: pricing multiplier applied to every base price (e.g. 1.0, 2.5).
# Useful for promotions or premium tiers without editing the catalog.
PRICE_MULTIPLIER=1.0
