# ============================================================================
# AgentForge Intelligence Suite - Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values:
#   cp .env-local .env
# ============================================================================

# ----- Required: payments -----
# EVM wallet address that receives x402 payments (USDC).
EVM_ADDRESS=

# x402 facilitator that verifies and settles payments.
FACILITATOR_URL=https://x402.org/facilitator

# Blockchain network in CAIP-2 format. Base Sepolia testnet by default.
# Use eip155:8453 for Base mainnet in production.
NETWORK=eip155:84532

# ----- Ports -----
# Local dev serves the two transports on separate ports.
MCP_PORT=4022
HTTP_PORT=4021
# When PORT is set (Railway and most PaaS inject it), BOTH transports are served
# from that single port instead. Leave unset locally.
# PORT=8080

# Public base URLs advertised in the catalog / discovery metadata. Set these to
# your deployed origin(s) so AI agents and Agentic.market can reach you.
MCP_PUBLIC_URL=http://localhost:4022
HTTP_PUBLIC_URL=http://localhost:4021

# ----- Real intelligence providers (optional but recommended for production) -----
# OpenAI-compatible Chat Completions endpoint that powers the NLP, research, and
# code-review services. Works with OpenAI, Azure OpenAI, OpenRouter, Together,
# Groq, or a self-hosted gateway. If LLM_API_KEY is unset, those services fall
# back to their built-in deterministic algorithms.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Market data for the market_intelligence service.
# Crypto works key-free via CoinGecko; a demo key raises rate limits.
COINGECKO_API_KEY=
# Equities require a free Alpha Vantage key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Upstream provider request timeout (ms).
PROVIDER_TIMEOUT_MS=15000

# ----- Operational tuning (optional) -----
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Global multiplier applied to every base price (e.g. 1.0, 2.5).
PRICE_MULTIPLIER=1.0
